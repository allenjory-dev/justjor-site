---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const startHere = [
  {
    title: "Life OS Agent",
    blurb: "My personal AI assistant that helps organize private logs, schedule, notes, and daily briefings.",
    href: "#life-os",
  },
  {
    title: "Benefits Maximizer",
    blurb: "The case study where Life OS found $4,300/year in unused workplace benefits and helped me claim $900 in one session.",
    href: "/blog/benefits-maximizer",
  },
  {
    title: "Golf Caddy Module",
    blurb: "A voice-controlled golf tracker that logs rounds hands-free, learns club distances, and suggests clubs from my own data.",
    href: "/blog/golf-caddy-module",
  },
  {
    title: "JustJor Travel",
    blurb: "The human side: Thailand, Vietnam, the Rockies, and whatever else I film while testing these systems in the real world.",
    href: "https://www.youtube.com/@realjustjor",
  },
];

const projects = [
  {
    title: "Life OS Agent",
    blurb: "Personal AI assistant. 100+ tools across 20 Python modules. Connects private logs, notes, scheduling, and daily decision support.",
    href: "/life-os-showcase.html",
    tag: "Active",
  },
  {
    title: "Benefits Maximizer",
    blurb: "Used my own bot to audit my workplace benefits plan. Found $4,300/year of unclaimed value. Now a productizable service for other employees.",
    href: "/blog/benefits-maximizer",
    tag: "Case study",
  },
  {
    title: "JustJor YouTube",
    blurb: "Travel and adventure content from Thailand, Vietnam, the Rockies, and wherever else the calendar opens. Authentic, slightly gritty, work in progress.",
    href: "https://www.youtube.com/@realjustjor",
    tag: "External",
  },
  {
    title: "Golf Caddy Module",
    blurb: "Voice-controlled score tracking that logs shots, putts, clubs, and distance notes hands-free while I play. It now learns my club distances and can suggest a club from my own data.",
    href: "/blog/golf-caddy-module",
    tag: "Shipped",
  },
];

const proofBlocks = [
  {
    label: "Morning briefing",
    title: "Daily context before the day starts",
    sample: ["Morning brief", "Recovery: lighter day suggested", "Schedule: one field appointment", "Nudge: submit eligible receipt"],
  },
  {
    label: "Meal tracking",
    title: "Food photo to usable log",
    sample: ["Photo received", "Estimated: 42g protein | 610 kcal", "Logged to daily nutrition note", "Follow-up: low fiber so far"],
  },
  {
    label: "Benefits audit",
    title: "Unused buckets turned into actions",
    sample: ["Vision: unused balance", "Wellness: eligible receipt found", "Paramedical: category gap", "Next action: file claim"],
  },
  {
    label: "Golf caddy",
    title: "Voice command to scorecard",
    sample: ["shot 7 iron 150", "stroke logged | club distance learned", "what club for 150?", "suggestion based on personal median"],
  },
];

const nowItems = [
  "Building Life OS into a full personal operating system",
  "Turning Benefits Maximizer into a simple, repeatable audit service",
  "Testing the voice-controlled golf caddy on real rounds",
  "Growing JustJor on YouTube without sanding off the weird edges",
  "Documenting practical AI workflows for regular people and small operators",
];

const pillars = [
  { title: "Build", blurb: "Life OS, AI agents, tools, and experiments." },
  { title: "Optimize", blurb: "Health, money, time, benefits, and systems." },
  { title: "Explore", blurb: "Travel, golf, snowboarding, YouTube, and real-world testing." },
  { title: "Document", blurb: "What worked, what broke, and what I learned." },
];
---

<Layout
  title="Jor Allen - practical AI systems for real life"
  description="Jor Allen builds practical AI systems for real life, starting with Life OS: a personal AI assistant for private logs, scheduling, notes, and daily decisions."
>
  <!-- HERO -->
  <section class="container-wide py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="font-mono text-accent text-sm mb-6 tracking-wider uppercase">
        Hey, I'm Jor.
      </p>
      <h1 class="mb-8">
        I build practical AI systems for real life.
      </h1>
      <p class="text-fg-muted text-lg mb-10 max-w-2xl leading-relaxed">
        I'm documenting Life OS, my personal AI assistant for private logs, scheduling,
        notes, travel, and daily decisions. It already found $4,300/year
        in unused workplace benefits and replaced parts of my golf app with a
        voice-controlled caddy.
      </p>
      <p class="text-fg-muted text-lg mb-10 max-w-2xl leading-relaxed">
        Day job: construction code compliance. Side quest: building the operating
        system for my life and showing the messy parts as I go.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/blog/benefits-maximizer" class="btn-primary">
          Start here: read the case study
        </a>
        <a href="https://www.youtube.com/@realjustjor" class="btn-secondary">
          Watch JustJor on YouTube
        </a>
        <a href="https://github.com/allenjory-dev" class="btn-secondary">
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- START HERE -->
  <section class="border-t border-border py-24 bg-bg-elevated">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-12 mb-12">
        <div class="md:col-span-1">
          <p class="font-mono text-accent text-sm tracking-wider uppercase">
            Start here
          </p>
        </div>
        <div class="md:col-span-2">
          <h2 class="mb-4">The quick map.</h2>
          <p class="text-fg-muted text-lg leading-relaxed">
            The brand is practical AI for real life: build the system, use it on
            messy human problems, then document what actually happened.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {startHere.map((item, index) => (
          <a href={item.href} class="card group">
            <p class="font-mono text-xs text-fg-subtle mb-3">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="text-xl mb-3 group-hover:text-accent transition-colors">
              {item.title}
            </h3>
            <p class="text-fg-muted leading-relaxed">{item.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="border-t border-border py-24">
    <div class="container-wide grid md:grid-cols-3 gap-12">
      <div class="md:col-span-1">
        <img
          src="/me.jpg"
          alt="Jor Allen"
          class="w-full max-w-xs mb-8 rounded-lg object-cover aspect-[4/5] border border-border"
        />
        <p class="font-mono text-accent text-sm tracking-wider uppercase">
          About
        </p>
      </div>
      <div class="md:col-span-2 prose-custom max-w-prose">
        <p class="text-fg text-xl mb-6">
          I'm Jor. By day I work in construction code compliance. By night I'm building things I wish existed.
        </p>
        <h2 id="life-os">What I'm building</h2>
        <p>
          The main project is <strong class="text-fg">Life OS</strong> — a personal AI assistant
          I wrote in Python that connects private logs, notes, scheduling, finance context,
          health context, and daily decision support. The public version is the story of the
          system; the private version keeps the actual services, credentials, and raw data off
          the internet.
        </p>
        <p>
          The most useful thing it's done so far: ran a full audit of my workplace benefits plan,
          found roughly $4,300/year I was leaving on the table, and walked me through claiming the
          $900 Personal Wellness Account in one session.
        </p>
        <h2>Why I'm documenting it</h2>
        <p>
          Most AI content is either hype or tutorials. I'm more interested in what happens when
          you wire AI into an actual life: meals, money, calendar chaos, benefits booklets, golf
          rounds, travel, missed receipts, and the weird failures along the way.
        </p>
        <h2>What else I do</h2>
        <p>
          When I'm not building or doing safety inspections, I run a small YouTube channel called
          JustJor — travel content from Thailand, Vietnam, the Rockies, and wherever else the
          year takes me. The aesthetic is authentic and slightly gritty. The audience is small
          (24 subscribers as of writing). The intent is to grow it on my own terms.
        </p>
        <p class="text-fg-muted italic">
          This site is where I document the building — what works, what doesn't, what I'm learning.
        </p>

        <div class="not-prose mt-10 grid sm:grid-cols-2 gap-4">
          {pillars.map((pillar) => (
            <div class="card">
              <h3 class="text-lg mb-2">{pillar.title}</h3>
              <p class="text-fg-muted text-sm leading-relaxed">{pillar.blurb}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 grid grid-cols-2 gap-4">
          <figure>
            <img
              src="/adventure.jpg"
              alt="Caving in Vietnam — cupping water from a cave waterfall"
              class="w-full rounded-lg object-cover aspect-[4/5] border border-border"
              loading="lazy"
            />
            <figcaption class="font-mono text-xs text-fg-subtle mt-2">
              Hang Va cave, Vietnam
            </figcaption>
          </figure>
          <figure>
            <img
              src="/travel.jpg"
              alt="Gyeongbokgung Palace, Seoul"
              class="w-full rounded-lg object-cover aspect-[4/5] border border-border"
              loading="lazy"
            />
            <figcaption class="font-mono text-xs text-fg-subtle mt-2">
              Gyeongbokgung Palace, Seoul
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED — Benefits Maximizer Story -->
  <section class="border-t border-border py-24 bg-bg-elevated">
    <div class="container-wide grid md:grid-cols-3 gap-12">
      <div class="md:col-span-1">
        <p class="font-mono text-accent text-sm tracking-wider uppercase">
          Featured
        </p>
      </div>
      <div class="md:col-span-2">
        <h2 class="mb-6">
          I built a bot that found $4,300/year of unused workplace benefits.
        </h2>
        <p class="text-fg-muted text-lg leading-relaxed mb-6">
          Most employees use 30-40% of the benefits their employer pays for. The rest expires
          December 31 every year. Not because people are lazy — because the booklets are 50+ pages
          of insurance jargon and HR can't legally tell you what to claim.
        </p>
        <p class="text-fg-muted text-lg leading-relaxed mb-6">
          I asked my Life OS bot to read my plan booklet, cross-reference my claim records,
          and tell me what I was missing. Thirty minutes later it surfaced $8,500 of unclaimed
          annual value and walked me through filing $900 of it the same afternoon.
        </p>
        <p class="text-fg-muted text-lg leading-relaxed mb-8">
          The repeatable pattern - read the booklet, audit the buckets, surface the gaps, file
          the claims - is now a service I'm productizing for other employees who don't have a
          personal AI bot lying around.
        </p>
        <a href="/blog/benefits-maximizer" class="btn-primary">
          Read the case study
        </a>
      </div>
    </div>
  </section>

  <!-- PROOF BLOCKS -->
  <section class="border-t border-border py-24">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-12 mb-12">
        <div class="md:col-span-1">
          <p class="font-mono text-accent text-sm tracking-wider uppercase">
            Proof
          </p>
        </div>
        <div class="md:col-span-2">
          <h2 class="mb-4">What Life OS looks like in practice.</h2>
          <p class="text-fg-muted text-lg leading-relaxed">
            These are public-safe sample outputs, not private screenshots or real account data.
            The point is the shape: real inputs, useful context, specific next actions.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {proofBlocks.map((block) => (
          <div class="card">
            <p class="font-mono text-xs text-accent uppercase tracking-wider mb-3">
              {block.label}
            </p>
            <h3 class="text-xl mb-4">{block.title}</h3>
            <div class="rounded-lg border border-border bg-bg p-4 font-mono text-sm text-fg-muted space-y-2">
              {block.sample.map((line) => (
                <p>{line}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS GALLERY -->
  <section id="projects" class="border-t border-border py-24">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-12 mb-12">
        <div class="md:col-span-1">
          <p class="font-mono text-accent text-sm tracking-wider uppercase">
            Projects
          </p>
        </div>
        <div class="md:col-span-2">
          <h2 class="mb-4">What I'm building.</h2>
          <p class="text-fg-muted text-lg">
            Some shipped, some still cooking. Updated as things move.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <a href={project.href} class="card group">
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-xl group-hover:text-accent transition-colors">
                {project.title}
              </h3>
              <span class="text-xs font-mono uppercase tracking-wider text-fg-subtle border border-border rounded px-2 py-1">
                {project.tag}
              </span>
            </div>
            <p class="text-fg-muted leading-relaxed">{project.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NOW -->
  <section class="border-t border-border py-24">
    <div class="container-wide grid md:grid-cols-3 gap-12">
      <div class="md:col-span-1">
        <p class="font-mono text-accent text-sm tracking-wider uppercase">
          Now
        </p>
      </div>
      <div class="md:col-span-2">
        <h2 class="mb-6">What I'm working on now.</h2>
        <ul class="space-y-4">
          {nowItems.map((item) => (
            <li class="text-fg-muted text-lg leading-relaxed border-b border-border pb-4">
              {item}
            </li>
          ))}
        </ul>
        <div class="mt-10">
          <a href="mailto:jor@justjor.me?subject=Following%20the%20Life%20OS%20build" class="btn-secondary">
            Follow the build
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG PREVIEW -->
  {recentPosts.length > 0 && (
    <section class="border-t border-border py-24 bg-bg-elevated">
      <div class="container-wide grid md:grid-cols-3 gap-12">
        <div class="md:col-span-1">
          <p class="font-mono text-accent text-sm tracking-wider uppercase">
            Writing
          </p>
        </div>
        <div class="md:col-span-2">
          <h2 class="mb-8">Recent posts.</h2>
          <ul class="space-y-6">
            {recentPosts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`} class="block group">
                  <p class="font-mono text-xs text-fg-subtle mb-1">
                    {new Date(post.data.pubDate).toLocaleDateString("en-CA", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </p>
                  <h3 class="text-2xl mb-2 group-hover:text-accent transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-fg-muted">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-10">
            <a href="/blog" class="text-accent hover:text-accent-hover">
              All posts →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>
