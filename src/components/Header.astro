---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
];

const pathname = Astro.url.pathname;
---

<header class="border-b border-border bg-bg/80 backdrop-blur-sm sticky top-0 z-50">
  <nav class="container-wide flex items-center justify-between py-4">
    <a href="/" class="text-fg font-mono font-medium text-lg hover:text-accent transition-colors">
      jor<span class="text-accent">.</span>
    </a>

    <ul class="flex items-center gap-1 md:gap-2">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 text-sm rounded-md hover:bg-bg-elevated transition-colors",
              pathname === item.href ? "text-accent" : "text-fg-muted hover:text-fg",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
